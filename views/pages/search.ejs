<%- include('../partials/head', { title: 'Find a room' }) %>
<%- include('../partials/navbar', { user: user }) %>
<main class="page">
  <h1>Find a room near your college</h1>
  <div class="split">
    <aside class="form-card" style="max-width:none;">
      <h3>Filters</h3>
      <form id="filter-form">
        <div class="field">
          <label for="collegeId">College</label>
          <select id="collegeId" name="collegeId">
            <option value="">Any college</option>
            <% colleges.forEach(function (c) { %>
              <option value="<%= c.id %>"><%= c.name %> (<%= c.city %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="field-row">
          <div class="field"><label for="minBudget">Min rent</label><input type="number" id="minBudget" name="minBudget" min="0" /></div>
          <div class="field"><label for="maxBudget">Max rent</label><input type="number" id="maxBudget" name="maxBudget" min="0" /></div>
        </div>
        <div class="field">
          <label for="genderPreference">Gender preference</label>
          <select id="genderPreference" name="genderPreference">
            <option value="">Any</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
          </select>
        </div>
        <div class="field">
          <label>Amenities</label>
          <div class="checkbox-grid">
            <% amenities.forEach(function (a) { %>
              <label><input type="checkbox" name="amenityIds" value="<%= a.id %>" /> <%= a.name %></label>
            <% }) %>
          </div>
        </div>
        <button type="submit" class="btn-pill">Apply filters</button>
      </form>
    </aside>
    <section>
      <div id="results" class="grid"></div>
    </section>
  </div>
</main>
<%- include('../partials/footer', { pageScript: '/js/search.js' }) %>
