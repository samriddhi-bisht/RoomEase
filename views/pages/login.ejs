<%- include('../partials/head', { title: 'Log in' }) %>
<%- include('../partials/navbar', { user: user }) %>
<main class="page">
  <div class="form-card">
    <h1>Log in</h1>
    <form id="login-form">
      <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" required /></div>
      <div class="field"><label for="password">Password</label><input type="password" id="password" name="password" required /></div>
      <div class="form-error" id="login-error"></div>
      <button type="submit" class="btn-pill">Log in</button>
    </form>
    <p class="card-meta">No account yet? <a href="/signup">Sign up</a></p>
  </div>
</main>
<%- include('../partials/footer', { pageScript: '/js/login.js' }) %>
