<%- include('../partials/head', { title: 'Roommates' }) %>
<%- include('../partials/navbar', { user: user }) %>
<main class="page">
  <h1>Roommate matching</h1>
  <div class="split">
    <div class="form-card" style="max-width:none;">
      <h3>Your profile</h3>
      <form id="profile-form">
        <div class="field">
          <label for="collegeId">College</label>
          <select id="collegeId" name="collegeId">
            <option value="">Select college</option>
            <% colleges.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
        <div class="field-row">
          <div class="field"><label for="budgetMin">Budget min</label><input type="number" id="budgetMin" name="budgetMin" /></div>
          <div class="field"><label for="budgetMax">Budget max</label><input type="number" id="budgetMax" name="budgetMax" /></div>
        </div>
        <div class="field"><label for="habits">Habits</label><input type="text" id="habits" name="habits" placeholder="e.g. early riser, non-smoker" /></div>
        <div class="field"><label for="bio">Bio</label><textarea id="bio" name="bio" rows="3"></textarea></div>
        <div class="form-error" id="profile-error"></div>
        <div class="form-success" id="profile-success"></div>
        <button type="submit" class="btn-pill">Save profile</button>
      </form>
    </div>
    <div>
      <h3>Browse other students</h3>
      <div id="roommate-results"><p>Loading…</p></div>
    </div>
  </div>
</main>
<%- include('../partials/footer', { pageScript: '/js/roommates.js' }) %>
